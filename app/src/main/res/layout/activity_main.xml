<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ===================== PAIRING SCREEN ===================== -->
    <LinearLayout
        android:id="@+id/pairingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JARVIS REMOTE"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/pairStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not paired"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/scanQrButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_qr"
            android:backgroundTint="@color/cyan_dim"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/manualEntryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enter_manually"
            android:background="@android:color/transparent"
            android:textColor="@color/cyan" />

        <LinearLayout
            android:id="@+id/manualEntryLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp">

            <EditText
                android:id="@+id/manualUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://xxxx.trycloudflare.com"
                android:textColorHint="@color/text_dim"
                android:textColor="@color/text_primary"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/manualCodeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="8-CHAR CODE"
                android:textColorHint="@color/text_dim"
                android:textColor="@color/text_primary"
                android:inputType="textCapCharacters"
                android:maxLength="8" />

            <Button
                android:id="@+id/manualPairButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pair"
                android:backgroundTint="@color/cyan_dim"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== CHAT SCREEN ===================== -->
    <LinearLayout
        android:id="@+id/chatLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:background="@color/panel">

            <View
                android:id="@+id/connectionDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_connected"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/connectionStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="JARVIS"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <Button
                android:id="@+id/signOutButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sign_out"
                android:textSize="11sp"
                android:background="@android:color/transparent"
                android:textColor="@color/danger" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/messageContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:background="@color/panel">

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/message_hint"
                android:textColorHint="@color/text_dim"
                android:textColor="@color/text_primary"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/send"
                android:backgroundTint="@color/cyan_dim"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
